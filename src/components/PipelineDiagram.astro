---
import PipelineFlow from './PipelineFlow.tsx';
import { spine, activation, performance, measurement } from '../data/pipeline';

const groups = [
  { label: 'Pipeline', stages: spine },
  { label: 'Activation', stages: activation },
  { label: performance.title, stages: [] as typeof spine },
  { label: 'Performance Measuring', stages: measurement },
];
---
<section id="services" class="wrap section">
  <div class="label">What I build</div>
  <h2>The engine, end to end.</h2>
  <p class="pf-sub">One system, from raw TAM to activated pipeline to the reporting that proves it. Click any node to see what happens inside.</p>

  <!-- Interactive canvas (desktop / tablet) -->
  <div class="pf-desktop">
    <PipelineFlow client:visible />
  </div>

  <!-- Readable stacked fallback (mobile + no-JS + screen readers) -->
  <div class="pf-mobile">
    {groups.map((g) => (
      <div class="pfm-group">
        <div class="pfm-group-label">{g.label}</div>
        {g.label === performance.title ? (
          <div class="pfm-card pfm-hub"><strong>{performance.title}</strong><p>{performance.teaser}</p></div>
        ) : (
          g.stages.map((s) => (
            <div class="pfm-card">
              <strong>{s.title}</strong>
              {s.teaser && <p>{s.teaser}</p>}
              <ul>{s.items.map((it) => <li><b>{it.label}</b> — {it.detail}</li>)}</ul>
            </div>
          ))
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .pf-sub{color:var(--muted);max-width:620px;margin-bottom:8px}

  /* Toggle canvas vs. stacked list by viewport */
  .pf-mobile{display:none}
  @media (max-width:700px){
    .pf-desktop{display:none}
    .pf-mobile{display:block;margin-top:24px}
  }

  /* Mobile stacked fallback */
  .pfm-group{margin-top:22px}
  .pfm-group-label{font-size:12px;font-weight:650;letter-spacing:.08em;text-transform:uppercase;
    color:var(--accent);margin-bottom:10px}
  .pfm-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:10px}
  .pfm-card > strong{font-size:15px;letter-spacing:-.01em}
  .pfm-card p{margin:4px 0 0;font-size:13px;color:var(--muted)}
  .pfm-card ul{margin:10px 0 0;padding-left:0;list-style:none}
  .pfm-card li{font-size:13px;line-height:1.5;color:#26304a;padding-top:8px}
  .pfm-card li b{color:var(--ink)}
  .pfm-hub{background:var(--accent);border-color:var(--accent)}
  .pfm-hub > strong,.pfm-hub p{color:#fff}
</style>
