---
import StageCard from './StageCard.astro';
import { spine, activation, performance, measurement } from '../data/pipeline';
---
<section id="services" class="wrap section">
  <div class="label">What I build</div>
  <h2>The engine, end to end.</h2>
  <p class="pl-sub">One system, from raw TAM to activated pipeline to the reporting that proves it. Click any stage to see what happens inside.</p>

  <div class="pl-flow">
    <!-- Spine -->
    {spine.map((stage, i) => (
      <>
        <div class="pl-spine-row"><StageCard stage={stage} index={i} variant="spine" /></div>
        <div class="pl-link" aria-hidden="true"></div>
      </>
    ))}

    <!-- Fan-out: Activation -->
    <div class="pl-fanlabel">Activation</div>
    <div class="pl-link pl-link-short" aria-hidden="true"></div>
    <div class="pl-branches pl-fanned pl-converged">
      {activation.map((stage) => (
        <div class="pl-branch"><StageCard stage={stage} variant="branch" /></div>
      ))}
    </div>

    <!-- Converge -->
    <div class="pl-link pl-link-short" aria-hidden="true"></div>
    <div class="pl-spine-row">
      <div class="pl-card pl-hub" role="group" aria-label={performance.title}>
        <div class="pl-head">
          <div class="pl-headtext">
            <span class="pl-title">{performance.title}</span>
            {performance.teaser && <span class="pl-teaser">{performance.teaser}</span>}
          </div>
        </div>
      </div>
    </div>

    <!-- Fan-out: Measurement -->
    <div class="pl-link pl-link-short" aria-hidden="true"></div>
    <div class="pl-branches pl-fanned">
      {measurement.map((stage) => (
        <div class="pl-branch"><StageCard stage={stage} variant="branch" /></div>
      ))}
    </div>
  </div>
</section>

<style>
  .pl-sub{color:var(--muted);max-width:620px}
  .pl-flow{margin-top:32px;display:flex;flex-direction:column;align-items:center}

  /* Centered spine rows */
  .pl-spine-row{width:100%;max-width:560px;display:flex;justify-content:center}
  .pl-spine-row > *{width:100%}

  /* Vertical connectors */
  .pl-link{width:2px;height:26px;background:var(--line)}
  .pl-link-short{height:16px}

  /* Fan-out label pill */
  .pl-fanlabel{margin-top:10px;font-size:12px;font-weight:650;letter-spacing:.08em;text-transform:uppercase;
    color:var(--accent);background:var(--accent-soft);padding:5px 14px;border-radius:999px}

  /* Branch grid (4-up) */
  .pl-branches{width:100%;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;position:relative}
  .pl-branch{position:relative;display:flex}
  .pl-branch > *{width:100%}
  /* top rail + stubs (fan-out) */
  .pl-fanned::before{content:'';position:absolute;top:-16px;left:12.5%;right:12.5%;height:2px;background:var(--line)}
  .pl-fanned .pl-branch::before{content:'';position:absolute;top:-16px;left:50%;transform:translateX(-50%);width:2px;height:16px;background:var(--line)}
  /* bottom rail + stubs (converge) */
  .pl-converged::after{content:'';position:absolute;bottom:-16px;left:12.5%;right:12.5%;height:2px;background:var(--line)}
  .pl-converged .pl-branch::after{content:'';position:absolute;bottom:-16px;left:50%;transform:translateX(-50%);width:2px;height:16px;background:var(--line)}

  /* Cards */
  .pl-card{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden}
  .pl-card summary{list-style:none;cursor:pointer;display:flex;align-items:flex-start;gap:12px;
    justify-content:space-between;padding:16px 18px}
  .pl-card summary::-webkit-details-marker{display:none}
  .pl-head{display:flex;gap:12px;align-items:flex-start;min-width:0}
  .pl-num{flex:none;font-size:12px;font-weight:700;color:var(--accent);background:var(--accent-soft);
    border-radius:8px;padding:3px 8px;line-height:1.4}
  .pl-headtext{display:flex;flex-direction:column;gap:3px;min-width:0}
  .pl-title{font-size:16px;font-weight:650;letter-spacing:-.01em}
  .pl-teaser{font-size:13px;color:var(--muted);line-height:1.45}
  .pl-count{font-weight:600;color:var(--accent)}
  .pl-chev{flex:none;color:var(--muted);margin-top:3px;transition:transform .18s ease}
  .pl-card[open] .pl-chev{transform:rotate(180deg)}
  .pl-card[open]{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}

  .pl-items{margin:0;padding:0 18px 16px;list-style:none;border-top:1px solid var(--line)}
  .pl-items li{font-size:13.5px;line-height:1.55;color:#26304a;padding-top:12px}
  .pl-items strong{color:var(--ink);font-weight:650}

  /* Converge hub */
  .pl-hub{background:var(--accent);border-color:var(--accent);text-align:center}
  .pl-hub .pl-head{justify-content:center;width:100%}
  .pl-hub .pl-headtext{align-items:center;padding:16px 18px}
  .pl-hub .pl-title{color:#fff;font-size:17px}
  .pl-hub .pl-teaser{color:#d9e1ff}

  .pl-branch .pl-title{font-size:15px}

  @media (max-width:820px){
    .pl-branches{grid-template-columns:1fr 1fr}
    .pl-fanned::before,.pl-converged::after{left:25%;right:25%}
  }
  @media (max-width:520px){
    .pl-branches{grid-template-columns:1fr;gap:10px}
    /* single column: drop the horizontal rails, keep simple vertical stubs */
    .pl-fanned::before,.pl-converged::after{display:none}
    .pl-fanned .pl-branch::before{top:-8px;height:8px}
    .pl-converged .pl-branch::after{display:none}
    .pl-fanned .pl-branch:first-child::before{display:none}
  }
  @media (prefers-reduced-motion: reduce){ .pl-chev{transition:none} }
</style>
